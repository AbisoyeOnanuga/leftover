# Copy this file to .env and fill only the tools you use.
# This example is safe to commit. Real keys, voice ids, and hosts belong in .env.

# Model on this machine. Leave the URL blank to use Ollama here.
# The name has to be a Gemma model. Another family turns the model off.
OLLAMA_URL=
OLLAMA_MODEL=gemma3:4b

# Voice. Leave both blank to keep the lines on screen.
# The key is the secret shown when the key was created, not the key id in the list.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional hosted Gemma. Leave the key blank to stay on Ollama.
# The id stays a Gemma model so the entry stays a Gemma entry.
# Create a model access key in DigitalOcean Gradient. Do not create a GPU droplet for this.
DO_INFERENCE_KEY=
DO_MODEL=gemma-4-31B-it
