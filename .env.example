# Copy this file to .env and fill only the tools you use.
# This example is safe to commit. Real keys, voice ids, and hosts belong in .env.

# Model. Leave the URL blank to use Ollama on this machine.
OLLAMA_URL=
OLLAMA_MODEL=gemma3:4b

# Voice. The voice id comes from your own account. Leave both blank to keep the lines on screen.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
